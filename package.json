{
  "name": "@byteboost/webpack-plugin",
  "version": "0.0.9-dev.5",
  "description": "",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "exports": {
    "require": "./dist/index.cjs",
    "import": "./dist/index.js"
  },
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "url": "https://github.com/ByteBoost-Organization/byteboost-webpack-sourcemap-plugin",
    "type": "github"
  },
  "private": false,
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "clean": "del ./dist",
    "build": "npm run clean && tsc && npm run rollup",
    "patch": "npm run build && npm version patch && npm publish && git push",
    "minor": "npm run build && npm version minor && npm publish && git push",
    "major": "npm run build && npm version major && npm publish && git push",
    "prerelease": "npm run clean && npm run build && npm version prerelease --preid=prerelease && npm publish && git push",
    "testBuild": "rollup ./dist/index.js --file ./dist/index.cjs --format cjs",
    "rollup": "rollup --config rollup.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.12.7",
    "del-cli": "^5.1.0",
    "prettier": "^3.2.5",
    "rollup": "^4.19.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0"
  },
  "dependencies": {
    "@byteboost/cli": "1.0.1-dev.3",
    "mime": "^4.0.1",
    "nanoid": "^5.0.7"
  }
}
